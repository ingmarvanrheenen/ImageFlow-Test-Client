# Test Client Configuration

# ===== OPTION 1: Test Local Development =====
# Use this for local testing
# TEST_API_URL=http://localhost:3000
# RAPIDAPI_PROXY_SECRET=test-secret
# NODE_ENV=development

# ===== OPTION 2: Test Your Deployed RapidAPI =====
# Get these values from https://rapidapi.com/developer/dashboard
# 1. Go to your API dashboard
# 2. Click "Test Endpoint" or "Code Snippets"
# 3. Copy the headers from the example code

# Your deployed API URL (e.g., Heroku, Railway, Render)
TEST_API_URL=https://your-api.herokuapp.com

# RapidAPI Proxy Secret (found in RapidAPI dashboard under API Settings)
RAPIDAPI_PROXY_SECRET=your-rapidapi-proxy-secret-here

# Optional: Test as a specific user (any value works for testing)
TEST_RAPIDAPI_USER=test-user-123
TEST_RAPIDAPI_SUBSCRIPTION=BASIC

# Set to 'production' to enable authentication checks
NODE_ENV=production
